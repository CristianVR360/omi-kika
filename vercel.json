{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin$",
      "dest": "/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/linktree$",
      "dest": "/linktree/index.html"
    },
    {
      "src": "/recomendaciones$",
      "dest": "/recomendaciones/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
